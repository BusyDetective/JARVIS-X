# --- Gemini ---
# GEMINI_MODEL below is a PLACEHOLDER, not a guarantee of availability.
# Check Gemini's current model list before relying on it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter ---
# OPENROUTER_MODEL below is a PLACEHOLDER. Free-tier model slugs change
# often — verify at https://openrouter.ai/models before relying on it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Ollama (local, optional — leave as-is if you don't run Ollama) ---
# OLLAMA_MODEL below is a PLACEHOLDER — set it to a model you have actually
# pulled locally (`ollama pull <model>`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Provider fallback order (comma-separated, configurable) ---
PROVIDER_ORDER=gemini,openrouter,ollama

# --- Networking ---
REQUEST_TIMEOUT_SECONDS=30

# --- Workspace root — future filesystem/coding tools are restricted to this
# directory. Relative paths resolve against the working directory JARVIS-X
# is launched from; set an absolute path to pin it explicitly. ---
WORKSPACE_ROOT=workspace

# --- Persistence — SQLite task database. Leave DB_PATH unset to default to
# <DATA_DIR>/jarvis.db (created automatically). ---
DATA_DIR=data
# DB_PATH=data/jarvis.db

# --- Conversations — default window for ConversationManager.get_recent_messages()
# and max length of auto-derived session titles. ---
# MAX_RECENT_MESSAGES=20
# SESSION_TITLE_MAX_LENGTH=60

# --- Capabilities — master switch for the capability framework. ---
# CAPABILITIES_ENABLED=true

# --- Web research (Phase 6). The search API key is NEVER hard-coded; without
# it the web tools are simply not installed. ---
# WEB_RESEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=
# WEB_REQUEST_TIMEOUT=15
# WEB_MAX_RESULTS=10
# WEB_MAX_PAGES=5
# WEB_MAX_RESPONSE_BYTES=2000000
# WEB_MAX_DOCUMENT_CHARS=8000
# WEB_MAX_REDIRECTS=5
# WEB_MAX_CONCURRENT_FETCHES=3
# WEB_MAX_TOOL_OUTPUT_CHARS=24000

# --- Software engineering (Phase 7). READ-ONLY: no writes, shell, push or PRs. ---
# SOFTWARE_ENGINEERING_ENABLED=true
# GITHUB_ENABLED=true
# GITHUB_TOKEN=            # optional; never commit a real token
# GITHUB_REQUEST_TIMEOUT=15
# GITHUB_MAX_RETRIES=2
# GITHUB_MAX_RESULTS=30
# GITHUB_MAX_PAGES=3
# GITHUB_MAX_FILE_SIZE=200000
# GITHUB_MAX_DIRECTORY_ENTRIES=200
# GITHUB_MAX_RESPONSE_CHARS=24000
# GITHUB_MAX_RESPONSE_BYTES=2000000
# WORKSPACE_ENABLED=true   # the root itself is WORKSPACE_ROOT (see above)
# WORKSPACE_MAX_FILE_SIZE=200000
# WORKSPACE_MAX_FILES=2000
# WORKSPACE_MAX_SEARCH_RESULTS=50
# WORKSPACE_MAX_OUTPUT_CHARS=24000
# ENGINEERING_ENABLED=true
# ENGINEERING_MAX_DIFF_CHARS=50000

# --- Self-improvement (Phase 8). OFF by default; approval/risk policy applies even when on. ---
# SELF_IMPROVEMENT_ENABLED=false
# SELF_IMPROVEMENT_ROOT=data/improvement
# SELF_IMPROVEMENT_SAFE_AUTOMATIC=false
# IMPROVEMENT_VALIDATION_TIMEOUT=900
# IMPROVEMENT_VALIDATION_MAX_OUTPUT_BYTES=200000
# IMPROVEMENT_VALIDATION_MEMORY_MB=2048
# IMPROVEMENT_VALIDATION_CPUS=2
# IMPROVEMENT_VALIDATION_PIDS=256
# Candidate code runs ONLY in a disposable container (no host fallback). Build the image first:
#   docker build -t jarvisx-validation:1 -f docker/validation.Dockerfile .
# IMPROVEMENT_ISOLATION_BACKEND=auto        # auto | docker | podman
# IMPROVEMENT_CONTAINER_IMAGE=jarvisx-validation:1
# IMPROVEMENT_CONTAINER_OCI_RUNTIME=        # optional: runc | crun | runsc

# --- Cybersecurity specialist (Phase 10). OFF by default. Every operation still requires
# approval (DANGEROUS/CONFIRM) via the existing permission system regardless of this flag.
# Scanning any target you do not have explicit written authorization to test is almost
# certainly illegal — see app/cybersecurity/scope.py and the example scope file below. ---
# CYBERSECURITY_ENABLED=false
# No default: unset means no authorization scope is configured, so every operation is
# denied (fail closed). Point this at a JSON file listing AuthorizedScope entries, e.g.:
#   [
#     {
#       "id": "acme-bugbounty-2026",
#       "domains": ["example.com"],
#       "operation_types": ["subdomain_enum", "alive_check", "endpoint_discovery",
#                            "tech_fingerprint", "risk_scoring", "report_generation"],
#       "expires_at": "2026-12-31T23:59:59Z",
#       "source": "Acme bug bounty program, HackerOne ref #12345",
#       "max_targets": 1
#     }
#   ]
# CYBERSECURITY_SCOPE_FILE=
# CYBERSECURITY_REPORT_DIR=data/cybersecurity/reports
# CYBERSECURITY_MAX_SUBDOMAINS=50
# CYBERSECURITY_MAX_HOSTS=15
# CYBERSECURITY_MAX_ENDPOINTS=100
# CYBERSECURITY_MAX_FINDINGS=200
# CYBERSECURITY_REQUEST_TIMEOUT=20
# CYBERSECURITY_OPERATION_TIMEOUT=180
# CYBERSECURITY_MAX_CONCURRENCY=10
# CYBERSECURITY_MAX_TOOL_OUTPUT_CHARS=24000
# CYBERSECURITY_CACHE_TTL_SECONDS=3600
# CYBERSECURITY_CACHE_MAX_DOMAINS=50
# The recon engine itself (vendor/ai_bug_bounty_recon/) needs `sublist3r` and `httpx` CLI
# binaries on PATH for full subdomain-enumeration coverage, and Python's playwright package
# importable (no browser binaries required for Phase 10's operations — only for that engine's
# own, unused-here, screenshot stage). It never reads ANTHROPIC_API_KEY for anything Phase 10
# calls (only its own unused exploit_generator module reads that, for its standalone CLI/dashboard).

# --- Dashboard (Phase 9). Start with:  python -m app.ui ---
# UI_ENABLED=true
# UI_HOST=127.0.0.1                 # non-loopback hosts are refused unless UI_ALLOW_REMOTE=true AND UI_AUTH_TOKEN is >=24 chars
# UI_PORT=8765
# UI_AUTH_TOKEN=                    # leave unset to get a random token printed at each start. Never commit a real value.
# UI_ALLOW_REMOTE=false
# UI_COOKIE_SECURE=false            # true when a TLS proxy serves the dashboard over HTTPS
# UI_EXTRA_ALLOWED_HOSTS=           # comma-separated host:port values accepted in the Host/Origin headers (reverse proxy)
# UI_MAX_MESSAGE_CHARS=8000
# UI_APPROVAL_TIMEOUT_SECONDS=300   # an unanswered approval is DENIED
# UI_MAX_CONCURRENT_RUNS=4
# UI_SESSION_TTL_SECONDS=28800

# --- Browser (Phase 9). OFF by default. Needs: pip install -r requirements-browser.txt, then YOU install a browser:
#       python -m playwright install chromium      (nothing is downloaded automatically)
# BROWSER_ENABLED=false
# BROWSER_EXECUTABLE_PATH=          # optional: use an existing Chromium/Chrome binary
# BROWSER_NO_SANDBOX=false          # set true only when running as root / in a container that cannot sandbox Chromium
# BROWSER_JAVASCRIPT_ENABLED=false  # page scripts are OFF by default
# BROWSER_NAVIGATION_TIMEOUT=20
# BROWSER_ACTION_TIMEOUT=10
# BROWSER_MAX_ACTIONS=30            # navigations/interactions per browser session
# BROWSER_MAX_REDIRECTS=5
# BROWSER_MAX_REQUESTS_PER_PAGE=150
# BROWSER_MAX_RESOURCE_BYTES=5000000
# BROWSER_MAX_TOTAL_BYTES=25000000
# BROWSER_MAX_TEXT_CHARS=8000
# BROWSER_MAX_LINKS=50
# BROWSER_MAX_FORM_FIELDS=30
# BROWSER_SCREENSHOT_MAX_BYTES=400000
# BROWSER_VIEWPORT_WIDTH=1280
# BROWSER_VIEWPORT_HEIGHT=800
# BROWSER_IDLE_SECONDS=300
# BROWSER_ALLOWED_PORTS=80,443
# BROWSER_ALLOWED_DOMAINS=          # optional comma-separated allow-list (subdomains included); empty = any PUBLIC host

# --- Voice (Phase 9). Both directions OFF by default; text input/output always works. ---
# VOICE_INPUT_ENABLED=false
# VOICE_STT_PROVIDER=none           # none | browser (Web Speech API; Chrome/Edge send audio to the vendor!) | faster_whisper (local, optional dep)
# VOICE_STT_MODEL=base              # faster_whisper model name
# VOICE_STT_MODEL_PATH=             # local model directory (preferred; no download)
# VOICE_STT_LANGUAGE=
# VOICE_STT_ALLOW_DOWNLOAD=false    # models are only downloaded if you set this to true
# VOICE_STT_TIMEOUT=60
# VOICE_MAX_AUDIO_BYTES=5000000
# SPEECH_OUTPUT_ENABLED=false
# SPEECH_SYNTHESIS_PROVIDER=none    # none | browser (client-side speechSynthesis)
# SPEECH_MAX_CHARS=2000
# SPEECH_CHUNK_CHARS=300
